# ---------------------------------------------------------------------------
# LegendaryBeasts — environment variables
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; this example file is safe to commit.
# ---------------------------------------------------------------------------

# Your Discord server (guild) ID. Already filled in for LegendaryBeasts.
# Used server-side by /api/discord to read member + online counts.
DISCORD_GUILD_ID=1537696716273221632

# The invite code from your permanent invite link — the part after discord.gg/
# Counts are read from this invite, so it must stay valid and never expire.
DISCORD_INVITE_CODE=Hr3pq4gpKa

# Webhook for the staff application form (/apply -> /api/apply).
# Discord: Channel Settings > Integrations > Webhooks > New Webhook > Copy URL.
# Point it at a PRIVATE staff-only channel.
# This never reaches the browser — the form posts to /api/apply, which calls it
# server-side. Leave blank and the form shows a "not configured yet" notice
# instead of failing silently.
DISCORD_WEBHOOK_URL=

# Optional. If your bot ever exposes a leaderboard endpoint, put its URL here
# and /leaderboard will use it instead of data/leaderboard.json.
# Expected response shape: [{ rank, name, level, xp, avatar }]
LEADERBOARD_API_URL=

# Optional. Sent as an Authorization header to LEADERBOARD_API_URL if set.
LEADERBOARD_API_TOKEN=
